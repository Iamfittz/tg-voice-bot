TELEGRAM_BOT_TOKEN=put_your_token_here

# Optional: Teams call records through Microsoft Graph.
GRAPH_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# A long random secret, up to 128 characters.
GRAPH_CLIENT_STATE=
# A public HTTPS address that forwards /graph/* to the bot.
GRAPH_PUBLIC_BASE_URL=
# The Telegram chat that receives call summaries.
GRAPH_NOTIFY_CHAT_ID=
